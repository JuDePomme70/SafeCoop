<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SafeCoop</AssemblyName>
    <RootNamespace>SafeCoop</RootNamespace>
    <!-- Intentionally disabled: building this project never installs it into the game. -->
    <DeployToModsFolder>false</DeployToModsFolder>
  </PropertyGroup>

  <Target Name="ValidateCoiRoot" BeforeTargets="ResolveReferences">
    <Error Condition="'$(COI_ROOT)' == ''" Text="Set COI_ROOT to the Captain of Industry installation folder." />
    <Error Condition="!Exists('$(COI_ROOT)\Captain of Industry_Data\Managed\Mafi.Core.dll')" Text="COI_ROOT does not point to a valid Captain of Industry installation." />
  </Target>

  <ItemGroup>
    <Reference Include="Mafi">
      <HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\Mafi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Base">
      <HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\Mafi.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Core">
      <HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\Mafi.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
